{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mpqtool-gui",
  "version": "0.1.0",
  "identifier": "io.github.lizy.mpqtool",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "mpqtool — MPQ 归档浏览器",
        "width": 1020,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
